#include <algorithm>
#include <cstdint>
#include <cstdlib>
#include <cstring>
#include <iostream>
#include <limits>
#include <string>
#include <vector>

#include "acl/acl.h"
#include "platform/soc_spec.h"
#include "tiling/platform/platform_ascendc.h"

#include "../op_kernel/index_fill_p0_tiling.h"
#include "../op_kernel/index_fill_p0_kernel.asc"

namespace {

constexpr uint64_t kDmaAlignmentBytes = 32;
constexpr uint64_t kReservedUbBytes = 16 * 1024;
constexpr uint64_t kMaxDataCopyBytes = 65504;
constexpr uint32_t kDoubleBufferCount = 2;
constexpr uint32_t kQueueCount = 2;

struct Capability {
    std::string socName;
    uint32_t npuArch = 0;
    uint32_t aivCoreCount = 0;
    uint64_t ubBytes = 0;
};

[[noreturn]] void Fail(const std::string& message)
{
    std::cerr << "P0 error: " << message << std::endl;
    std::exit(EXIT_FAILURE);
}

void Check(aclError status, const char* operation)
{
    if (status != ACL_SUCCESS) {
        Fail(std::string(operation) + " failed with ACL error " + std::to_string(status));
    }
}

uint64_t AlignDown(uint64_t value, uint64_t alignment)
{
    return value / alignment * alignment;
}

Capability QueryCapability(int32_t deviceId)
{
    const char* socName = aclrtGetSocName();
    if (socName == nullptr || std::strlen(socName) == 0) {
        Fail("aclrtGetSocName returned no SoC name");
    }

    int64_t aivCoreCount = 0;
    Check(aclrtGetDeviceInfo(deviceId, ACL_DEV_ATTR_VECTOR_CORE_NUM, &aivCoreCount),
          "aclrtGetDeviceInfo(ACL_DEV_ATTR_VECTOR_CORE_NUM)");
    if (aivCoreCount <= 0) {
        Fail("runtime reported no visible vector cores");
    }

    auto* platform = platform_ascendc::PlatformAscendCManager::GetInstance(socName);
    if (platform == nullptr) {
        Fail(std::string("PlatformAscendCManager has no platform data for ") + socName);
    }

    uint64_t ubBytes = 0;
    platform->GetCoreMemSize(platform_ascendc::CoreMemType::UB, ubBytes);
    if (ubBytes == 0) {
        Fail("PlatformAscendC returned UB size 0");
    }

    Capability capability;
    capability.socName = socName;
    capability.npuArch = static_cast<uint32_t>(platform->GetCurNpuArch());
    capability.aivCoreCount = static_cast<uint32_t>(aivCoreCount);
    capability.ubBytes = ubBytes;
    return capability;
}

CopyFillP0TilingData BuildTiling(const Capability& capability, uint64_t totalElements,
                                 CopyFillP0Mode mode, float fillValue)
{
    if (totalElements == 0) {
        Fail("totalElements must be non-zero");
    }

    // Four allocations are live in the worst copy pipeline: two queues, each
    // double-buffered. Keep a small platform-independent guard band for the
    // runtime and align every DMA tile to 32 B.
    const uint64_t usableUb = capability.ubBytes > kReservedUbBytes
        ? capability.ubBytes - kReservedUbBytes
        : capability.ubBytes / 2;
    const uint64_t perBufferBytes = AlignDown(
        std::min(usableUb / (kQueueCount * kDoubleBufferCount), kMaxDataCopyBytes),
        kDmaAlignmentBytes);
    const uint64_t tileElements = perBufferBytes / sizeof(float);
    if (tileElements == 0 || tileElements > std::numeric_limits<uint32_t>::max()) {
        Fail("calculated invalid UB tile size");
    }

    // A core receives several UB tiles. This limits over-partitioning for
    // short workloads while scaling blockDim to the actual visible AIV count.
    const uint64_t minElementsPerCore = tileElements * 4;
    const uint64_t requestedBlocks =
        (totalElements + minElementsPerCore - 1) / minElementsPerCore;
    const uint32_t blockDim = static_cast<uint32_t>(std::max<uint64_t>(
        1, std::min<uint64_t>(capability.aivCoreCount, requestedBlocks)));
    const uint64_t elementsPerCore = (totalElements + blockDim - 1) / blockDim;
    const uint64_t tailElements = totalElements - elementsPerCore * (blockDim - 1);

    return CopyFillP0TilingData {
        blockDim,
        static_cast<uint32_t>(tileElements),
        static_cast<uint32_t>(mode),
        0,
        totalElements,
        elementsPerCore,
        tailElements,
        fillValue,
        0,
    };
}

bool ParseUnsigned(const char* text, uint64_t* value)
{
    char* end = nullptr;
    const unsigned long long parsed = std::strtoull(text, &end, 10);
    if (end == text || *end != '\0') {
        return false;
    }
    *value = parsed;
    return true;
}

void PrintUsage(const char* program)
{
    std::cout << "Usage: " << program
              << " [--numel N] [--mode copy|fill|both] [--fill-value F]" << std::endl;
}

void RunAndVerify(aclrtStream stream, const CopyFillP0TilingData& tiling,
                  const std::vector<float>& input, std::vector<float>* output)
{
    const size_t bytes = input.size() * sizeof(float);
    uint8_t* inputDevice = nullptr;
    uint8_t* outputDevice = nullptr;
    uint8_t* tilingDevice = nullptr;

    Check(aclrtMalloc(reinterpret_cast<void**>(&inputDevice), bytes, ACL_MEM_MALLOC_HUGE_FIRST),
          "aclrtMalloc(input)");
    Check(aclrtMalloc(reinterpret_cast<void**>(&outputDevice), bytes, ACL_MEM_MALLOC_HUGE_FIRST),
          "aclrtMalloc(output)");
    Check(aclrtMalloc(reinterpret_cast<void**>(&tilingDevice), sizeof(tiling), ACL_MEM_MALLOC_HUGE_FIRST),
          "aclrtMalloc(tiling)");

    Check(aclrtMemcpyAsync(inputDevice, bytes, input.data(), bytes, ACL_MEMCPY_HOST_TO_DEVICE, stream),
          "aclrtMemcpyAsync(input)");
    Check(aclrtMemcpyAsync(tilingDevice, sizeof(tiling), &tiling, sizeof(tiling),
                           ACL_MEMCPY_HOST_TO_DEVICE, stream),
          "aclrtMemcpyAsync(tiling)");

    index_fill_p0_kernel<<<tiling.blockDim, nullptr, stream>>>(
        inputDevice, outputDevice, tilingDevice);
    Check(aclrtMemcpyAsync(output->data(), bytes, outputDevice, bytes, ACL_MEMCPY_DEVICE_TO_HOST, stream),
          "aclrtMemcpyAsync(output)");
    Check(aclrtSynchronizeStream(stream), "aclrtSynchronizeStream");

    Check(aclrtFree(tilingDevice), "aclrtFree(tiling)");
    Check(aclrtFree(outputDevice), "aclrtFree(output)");
    Check(aclrtFree(inputDevice), "aclrtFree(input)");
}

bool Verify(const CopyFillP0TilingData& tiling, const std::vector<float>& input,
            const std::vector<float>& output)
{
    for (size_t index = 0; index < output.size(); ++index) {
        const float expected = tiling.mode == static_cast<uint32_t>(CopyFillP0Mode::kCopy)
            ? input[index]
            : tiling.fillValue;
        if (output[index] != expected) {
            std::cerr << "verification mismatch at " << index << ": expected " << expected
                      << ", got " << output[index] << std::endl;
            return false;
        }
    }
    return true;
}

const char* ModeName(CopyFillP0Mode mode)
{
    return mode == CopyFillP0Mode::kCopy ? "copy" : "fill";
}

}  // namespace

int32_t main(int32_t argc, char* argv[])
{
    uint64_t totalElements = 1 * 1024 * 1024 + 17;
    std::string requestedMode = "both";
    float fillValue = 3.14159F;

    for (int32_t argument = 1; argument < argc; ++argument) {
        const std::string option = argv[argument];
        if (option == "--numel" && argument + 1 < argc) {
            if (!ParseUnsigned(argv[++argument], &totalElements) || totalElements == 0) {
                Fail("--numel must be a positive integer");
            }
        } else if (option == "--mode" && argument + 1 < argc) {
            requestedMode = argv[++argument];
            if (requestedMode != "copy" && requestedMode != "fill" && requestedMode != "both") {
                Fail("--mode must be copy, fill, or both");
            }
        } else if (option == "--fill-value" && argument + 1 < argc) {
            fillValue = std::strtof(argv[++argument], nullptr);
        } else if (option == "--help") {
            PrintUsage(argv[0]);
            return EXIT_SUCCESS;
        } else {
            PrintUsage(argv[0]);
            Fail("unknown argument: " + option);
        }
    }

    Check(aclInit(nullptr), "aclInit");
    constexpr int32_t deviceId = 0;
    Check(aclrtSetDevice(deviceId), "aclrtSetDevice");

    const Capability capability = QueryCapability(deviceId);
    std::cout << "[index_fill_p0 capability] soc=" << capability.socName
              << " npu_arch=" << capability.npuArch
              << " compiled_npu_arch=" << INDEX_FILL_P0_COMPILED_NPU_ARCH
              << " aiv_cores=" << capability.aivCoreCount
              << " ub_bytes=" << capability.ubBytes << std::endl;

    if (capability.npuArch != INDEX_FILL_P0_COMPILED_NPU_ARCH) {
        std::cout << "[index_fill_p0 fallback] no matching artifact; production path would use Triton"
                  << std::endl;
        Check(aclrtResetDevice(deviceId), "aclrtResetDevice");
        Check(aclFinalize(), "aclFinalize");
        return EXIT_SUCCESS;
    }

    aclrtStream stream = nullptr;
    Check(aclrtCreateStream(&stream), "aclrtCreateStream");

    std::vector<float> input(totalElements);
    std::vector<float> output(totalElements, 0.0F);
    for (uint64_t index = 0; index < totalElements; ++index) {
        input[index] = static_cast<float>((index % 251) - 125);
    }

    const std::vector<CopyFillP0Mode> modes = requestedMode == "both"
        ? std::vector<CopyFillP0Mode> {CopyFillP0Mode::kCopy, CopyFillP0Mode::kFill}
        : std::vector<CopyFillP0Mode> {requestedMode == "copy" ? CopyFillP0Mode::kCopy
                                                                  : CopyFillP0Mode::kFill};
    for (const CopyFillP0Mode mode : modes) {
        const CopyFillP0TilingData tiling = BuildTiling(capability, totalElements, mode, fillValue);
        std::fill(output.begin(), output.end(), 0.0F);
        std::cout << "[index_fill_p0 tiling] mode=" << ModeName(mode)
                  << " numel=" << totalElements
                  << " block_dim=" << tiling.blockDim
                  << " elements_per_core=" << tiling.elementsPerCore
                  << " tail_elements=" << tiling.tailElements
                  << " ub_tile_elements=" << tiling.tileElements
                  << " ub_tile_bytes=" << static_cast<uint64_t>(tiling.tileElements) * sizeof(float)
                  << std::endl;
        RunAndVerify(stream, tiling, input, &output);
        if (!Verify(tiling, input, output)) {
            Fail(std::string("verification failed for ") + ModeName(mode));
        }
        std::cout << "[index_fill_p0 result] mode=" << ModeName(mode) << " status=PASS" << std::endl;
    }

    Check(aclrtDestroyStream(stream), "aclrtDestroyStream");
    Check(aclrtResetDevice(deviceId), "aclrtResetDevice");
    Check(aclFinalize(), "aclFinalize");
    return EXIT_SUCCESS;
}
