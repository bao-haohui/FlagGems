#include "kernel_operator.h"
#include "index_fill_p0_tiling.h"

class KernelCopyFillP0 {
public:
    __aicore__ inline explicit KernelCopyFillP0(AscendC::TPipe* pipe) : pipe_(pipe) {}

    __aicore__ inline void Init(GM_ADDR input, GM_ADDR output,
                                const __gm__ CopyFillP0TilingData* tiling)
    {
        tiling_ = tiling;
        mode_ = tiling_->mode;
        fillValue_ = tiling_->fillValue;
        const uint32_t blockIdx = AscendC::GetBlockIdx();
        const uint64_t blockOffset = static_cast<uint64_t>(blockIdx) * tiling_->elementsPerCore;
        const bool isLastBlock = blockIdx + 1 == tiling_->blockDim;

        totalElements_ = isLastBlock ? tiling_->tailElements : tiling_->elementsPerCore;
        tileCount_ = static_cast<uint32_t>(
            (totalElements_ + tiling_->tileElements - 1) / tiling_->tileElements);

        inputGm_.SetGlobalBuffer((__gm__ float*)input + blockOffset, totalElements_);
        outputGm_.SetGlobalBuffer((__gm__ float*)output + blockOffset, totalElements_);

        const uint32_t tileBytes = tiling_->tileElements * sizeof(float);
        pipe_->InitBuffer(inputQueue_, 2, tileBytes);
        pipe_->InitBuffer(outputQueue_, 2, tileBytes);
    }

    __aicore__ inline void Process()
    {
        for (uint32_t tile = 0; tile < tileCount_; ++tile) {
            const uint32_t count = tile + 1 == tileCount_
                ? static_cast<uint32_t>(totalElements_ -
                    static_cast<uint64_t>(tile) * tiling_->tileElements)
                : tiling_->tileElements;
            const uint64_t offset = static_cast<uint64_t>(tile) * tiling_->tileElements;

            if (mode_ == static_cast<uint32_t>(CopyFillP0Mode::kCopy)) {
                CopyIn(offset, count);
                CopyToOutput(count);
            } else {
                FillOutput(count);
            }
            CopyOut(offset, count);
        }
    }

private:
    __aicore__ inline void CopyIn(uint64_t offset, uint32_t count)
    {
        AscendC::LocalTensor<float> inputLocal = inputQueue_.AllocTensor<float>();
        AscendC::DataCopyPad(inputLocal, inputGm_[offset],
            {1, static_cast<uint16_t>(count * sizeof(float)), 0, 0},
            {false, 0, 0, 0});
        inputQueue_.EnQue(inputLocal);
    }

    __aicore__ inline void CopyToOutput(uint32_t count)
    {
        AscendC::LocalTensor<float> inputLocal = inputQueue_.DeQue<float>();
        AscendC::LocalTensor<float> outputLocal = outputQueue_.AllocTensor<float>();
        AscendC::DataCopy(outputLocal, inputLocal, count);
        outputQueue_.EnQue(outputLocal);
        inputQueue_.FreeTensor(inputLocal);
    }

    __aicore__ inline void FillOutput(uint32_t count)
    {
        AscendC::LocalTensor<float> outputLocal = outputQueue_.AllocTensor<float>();
        AscendC::Duplicate(outputLocal, fillValue_, static_cast<int32_t>(count));
        outputQueue_.EnQue(outputLocal);
    }

    __aicore__ inline void CopyOut(uint64_t offset, uint32_t count)
    {
        AscendC::LocalTensor<float> outputLocal = outputQueue_.DeQue<float>();
        AscendC::DataCopyPad(outputGm_[offset], outputLocal,
            {1, static_cast<uint16_t>(count * sizeof(float)), 0, 0});
        outputQueue_.FreeTensor(outputLocal);
    }

    AscendC::TPipe* pipe_;
    const __gm__ CopyFillP0TilingData* tiling_;
    AscendC::GlobalTensor<float> inputGm_;
    AscendC::GlobalTensor<float> outputGm_;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> inputQueue_;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outputQueue_;
    uint64_t totalElements_ = 0;
    uint32_t tileCount_ = 0;
    uint32_t mode_ = 0;
    float fillValue_ = 0.0F;
};

extern "C" __global__ __vector__ void index_fill_p0_kernel(
    GM_ADDR input, GM_ADDR output, GM_ADDR tiling)
{
    AscendC::TPipe pipe;
    KernelCopyFillP0 op(&pipe);
    op.Init(input, output, (__gm__ CopyFillP0TilingData*)tiling);
    op.Process();
}
